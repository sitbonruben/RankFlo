FROM node:22-alpine AS deps
WORKDIR /app/apps/docs
COPY apps/docs/package.json ./
RUN npm install --ignore-scripts

FROM node:22-alpine AS builder
WORKDIR /app/apps/docs
COPY --from=deps /app/apps/docs/node_modules ./node_modules
COPY apps/docs .
ENV NEXT_TELEMETRY_DISABLED=1
ENV NODE_OPTIONS="--max-old-space-size=1024"
RUN npm run build

FROM node:22-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
RUN addgroup --system --gid 1001 nodejs
RUN adduser --system --uid 1001 nextjs
COPY --from=builder /app/apps/docs/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/apps/docs/.next/static ./.next/static
COPY --from=builder /app/apps/docs/public ./public
USER nextjs
EXPOSE 3001
ENV PORT=3001
ENV HOSTNAME="0.0.0.0"
CMD ["node", "server.js"]
