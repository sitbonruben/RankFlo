# ─── Database ────────────────────────────────
DATABASE_URL="postgresql://rankflo:password@localhost:5432/rankflo"

# ─── Redis ───────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ─── Auth ────────────────────────────────────
AUTH_SECRET="generate-a-random-32-char-string"
ADMIN_EMAIL="admin@rankflo.io"
ADMIN_PASSWORD="change-this-immediately"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# ─── App ─────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
RANKFLO_MODE="oss"

# ─── Email ───────────────────────────────────
SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="noreply@rankflo.io"

# ─── Search (optional) ──────────────────────
MEILISEARCH_URL=""
MEILISEARCH_API_KEY=""

# ─── Analytics (optional) ───────────────────
PLAUSIBLE_API_URL=""
PLAUSIBLE_API_KEY=""
UMAMI_API_URL=""
UMAMI_USERNAME=""
UMAMI_PASSWORD=""

# ─── Storage ────────────────────────────────
S3_BUCKET=""
S3_REGION=""
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_ENDPOINT=""

# ─── AI Providers (optional) ──────────────
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
AI_PROVIDER=""              # "openai", "anthropic", or "google" (auto-detected from keys if empty)
AI_MODEL=""                 # optional, uses provider default (e.g. gpt-4o, claude-sonnet-4-20250514)

# Google AI (optional)
GOOGLE_AI_API_KEY=""

# ─── Billing (SaaS only) ───────────────────
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
