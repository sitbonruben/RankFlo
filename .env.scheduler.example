# RankFlo Scheduler Configuration
# Copy this file to .env.local and fill in the values

# === Database ===
# Required for the scheduler to work
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://user:password@localhost:5432/rankflo

# === API Route Configuration (for /api/cron/publish) ===
# Required for secure access to the scheduling endpoint
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=your_32_character_secret_token_here_change_me

# === Standalone Script Configuration ===
# Log level for the scheduler script
# Options: debug, info, warn, error
# Default: info
LOG_LEVEL=info

# Run the scheduler in dry-run mode (no changes made)
# Useful for testing before enabling in production
# Default: false
DRY_RUN=false

# === Node.js Environment ===
# Set to 'production' when deployed
# Default: development
NODE_ENV=production

# === Optional: Database Pool Configuration ===
# If you experience connection pool issues, consider using connection pooling
# You would point DATABASE_URL to your pooling layer instead
# Example with PgBouncer:
# DATABASE_URL=postgresql://user:password@pgbouncer:6432/rankflo

# === Optional: Advanced Scheduling ===
# Custom log file location (for standalone script with cron)
# SCHEDULER_LOG_FILE=/var/log/rankflo-scheduler.log

# === Tips ===
# 1. Keep CRON_SECRET secure - treat it like a password
# 2. Use .env.local for local development
# 3. Use environment variables in your hosting platform for production
# 4. Rotate CRON_SECRET periodically
# 5. Monitor scheduler logs for errors
